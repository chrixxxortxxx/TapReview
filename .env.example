# Leave both Supabase values empty to run in DEMO MODE (in-browser data, demo logins).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL written to NFC tags and QR codes. Defaults to the current site origin.
# Example: https://tapreview.app
VITE_PUBLIC_BASE_URL=

# Optional custom map tiles (defaults to OpenStreetMap).
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
